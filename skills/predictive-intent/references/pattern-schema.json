{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Predictive Intent Pattern Database",
  "description": "Schema for the pattern database used by the Predictive Intent Engine",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "description": "Schema version",
      "const": "1.0.0"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of last pattern mining run"
    },
    "patterns": {
      "type": "array",
      "description": "Discovered behavioral patterns",
      "items": {
        "$ref": "#/definitions/pattern"
      }
    },
    "request_log": {
      "type": "array",
      "description": "Append-only log of user requests (stored separately in request-log.json)",
      "items": {
        "$ref": "#/definitions/request_entry"
      }
    },
    "anomalies": {
      "type": "array",
      "description": "Detected anomalies (stored separately in anomalies.json)",
      "items": {
        "$ref": "#/definitions/anomaly"
      }
    },
    "decisions": {
      "type": "array",
      "description": "Decision patterns for auto-completion (stored separately in decisions.json)",
      "items": {
        "$ref": "#/definitions/decision_pattern"
      }
    }
  },
  "required": ["version", "last_updated", "patterns"],
  "definitions": {
    "pattern": {
      "type": "object",
      "description": "A discovered behavioral pattern",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique pattern identifier (UUID v4)"
        },
        "type": {
          "type": "string",
          "enum": ["daily", "weekly", "monthly", "situational", "sequential"],
          "description": "Pattern recurrence type"
        },
        "description": {
          "type": "string",
          "description": "Human-readable description of the pattern"
        },
        "trigger": {
          "type": "object",
          "description": "What triggers this pattern",
          "properties": {
            "time_window": {
              "type": "object",
              "description": "Time window when pattern typically occurs",
              "properties": {
                "start_hour": { "type": "integer", "minimum": 0, "maximum": 23 },
                "end_hour": { "type": "integer", "minimum": 0, "maximum": 23 },
                "days_of_week": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"]
                  }
                }
              }
            },
            "context_signals": {
              "type": "array",
              "description": "Contextual signals that trigger this pattern",
              "items": {
                "type": "object",
                "properties": {
                  "signal_type": {
                    "type": "string",
                    "enum": ["keyword", "action", "project", "time_since_last", "external_event"]
                  },
                  "value": { "type": "string" }
                },
                "required": ["signal_type", "value"]
              }
            },
            "preceding_actions": {
              "type": "array",
              "description": "Actions that typically precede this pattern (for sequential patterns)",
              "items": { "type": "string" }
            }
          }
        },
        "predicted_action": {
          "type": "object",
          "description": "What action is predicted",
          "properties": {
            "category": {
              "type": "string",
              "description": "Action category (e.g., portfolio-check, project-status, research)"
            },
            "template": {
              "type": "string",
              "description": "Template of the predicted request"
            },
            "pre_compute_command": {
              "type": "string",
              "description": "Command to pre-compute the result"
            },
            "cache_ttl_minutes": {
              "type": "integer",
              "description": "How long the pre-computed result remains valid",
              "default": 30
            }
          },
          "required": ["category", "template"]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Confidence score (0-1) based on pattern consistency"
        },
        "occurrence_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Number of times this pattern has been observed"
        },
        "last_triggered": {
          "type": "string",
          "format": "date-time",
          "description": "Last time this pattern was triggered"
        },
        "hit_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "Ratio of successful predictions to total triggers"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "status": {
          "type": "string",
          "enum": ["active", "dormant", "retired"],
          "description": "Pattern lifecycle status"
        }
      },
      "required": ["id", "type", "description", "trigger", "predicted_action", "confidence", "occurrence_count", "created_at", "status"]
    },
    "request_entry": {
      "type": "object",
      "description": "A logged user request",
      "properties": {
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "request": {
          "type": "string",
          "description": "Normalized request text"
        },
        "category": {
          "type": "string",
          "description": "Request category"
        },
        "context": {
          "type": "object",
          "description": "Contextual metadata",
          "properties": {
            "project": { "type": "string" },
            "session_id": { "type": "string" },
            "day_of_week": { "type": "string" },
            "hour": { "type": "integer" },
            "preceding_requests": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        },
        "outcome": {
          "type": "string",
          "enum": ["completed", "modified", "abandoned"],
          "description": "How the user responded to the result"
        }
      },
      "required": ["timestamp", "request", "category", "context"]
    },
    "anomaly": {
      "type": "object",
      "description": "A detected anomaly",
      "properties": {
        "id": { "type": "string" },
        "timestamp": {
          "type": "string",
          "format": "date-time"
        },
        "type": {
          "type": "string",
          "enum": ["traffic_spike", "unusual_transaction", "behavior_change", "metric_deviation", "external_event"]
        },
        "severity": {
          "type": "string",
          "enum": ["low", "medium", "high", "critical"]
        },
        "description": { "type": "string" },
        "metric": {
          "type": "string",
          "description": "The metric that deviated"
        },
        "expected_value": { "type": "number" },
        "actual_value": { "type": "number" },
        "sigma_deviation": {
          "type": "number",
          "description": "Number of standard deviations from the mean"
        },
        "recommended_actions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "acknowledged": {
          "type": "boolean",
          "default": false
        }
      },
      "required": ["id", "timestamp", "type", "severity", "description"]
    },
    "decision_pattern": {
      "type": "object",
      "description": "A tracked decision pattern for auto-completion",
      "properties": {
        "id": { "type": "string" },
        "category": {
          "type": "string",
          "description": "Decision category (e.g., pr-approval, deploy-go-nogo)"
        },
        "description": { "type": "string" },
        "conditions": {
          "type": "object",
          "description": "Conditions under which this decision occurs",
          "additionalProperties": { "type": "string" }
        },
        "typical_outcome": {
          "type": "string",
          "description": "The most common decision outcome"
        },
        "consistency_rate": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "description": "How consistently the user makes the same decision"
        },
        "sample_count": {
          "type": "integer",
          "description": "Number of observed decisions"
        },
        "auto_complete_eligible": {
          "type": "boolean",
          "description": "Whether this meets the threshold for auto-completion (>90% consistency, >10 samples)"
        },
        "last_decision_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "category", "description", "typical_outcome", "consistency_rate", "sample_count", "auto_complete_eligible"]
    }
  }
}
